{
  "name": "waymarked",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Engine for a waymarked trail's website: one map, one sheet, a trail folder as content.",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && node build/check-trail.ts && npm test",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "maplibre-gl": "6.15.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "image-size": "2.0.4",
    "marked": "18.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
